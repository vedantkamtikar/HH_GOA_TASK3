# ==============================================================================
# Face Identification & Blockchain Verification Pipeline - Configuration
# ==============================================================================

# Path to your Google Cloud Service Account credentials JSON file:
GOOGLE_APPLICATION_CREDENTIALS="path/to/google_vision_credentials.json"

# Alternatively, direct Google Cloud Vision API Key (if using REST client):
# GOOGLE_VISION_API_KEY="AIzaSy..."

# Cosine similarity threshold for face match confirmation (0.0 to 1.0)
# A score >= 0.65 indicates high confidence match using Facenet 512-d embeddings
SIMILARITY_THRESHOLD=0.65

# Blockchain Ledger settings
LEDGER_DIR="ledger_data"
RECORDS_DIR="records"
